<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paris Paloma - Labour | Scrollable Slideshow</title>
  <style>
    :root {
      --bg-dark: #0f0a0a;
      --bg-card: #1b1212;
      --accent-crimson: #8b1e24;
      --accent-gold: #c9a66b;
      --text-light: #f3ece4;
      --text-muted: #b8a99a;
      --border-subtle: rgba(201, 166, 107, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      background-color: var(--bg-dark);
      color: var(--text-light);
      font-family: 'Georgia', 'Times New Roman', serif;
      overflow: hidden; /* Managed by the scroll-snap container */
    }

    /* Fixed Header Navigation */
    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      background: rgba(15, 10, 10, 0.92);
      backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.85rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .brand {
      font-size: 1.25rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent-gold);
      font-weight: bold;
    }

    .nav-dots {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .dot {
      padding: 0.45rem 0.85rem;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      cursor: pointer;
      font-family: inherit;
      font-size: 0.82rem;
      border-radius: 4px;
      transition: all 0.3s ease;
    }

    .dot.active, .dot:hover {
      background: var(--accent-crimson);
      color: var(--text-light);
      border-color: var(--accent-gold);
    }

    /* Vertical Full-Screen Scroll Container */
    main#scrollContainer {
      height: 100vh;
      width: 100vw;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
    }

    /* Each Slide Section */
    section.slide-page {
      min-height: 100vh;
      width: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 5.5rem 2rem 4rem 2rem;
    }

    .slide-card {
      width: 100%;
      max-width: 1280px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 2.2rem;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.85);
    }

    h1 {
      font-size: 2rem;
      color: var(--accent-gold);
      margin-bottom: 0.35rem;
    }

    h2 {
      font-size: 1.2rem;
      color: var(--accent-crimson);
      margin-bottom: 1.3rem;
      font-weight: normal;
      font-style: italic;
    }

    h3 {
      color: var(--accent-gold);
      margin-bottom: 0.4rem;
      font-size: 1.1rem;
    }

    p {
      line-height: 1.6;
      margin-bottom: 0.6rem;
      font-size: 0.98rem;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1.35fr;
      gap: 2rem;
      align-items: center;
    }

    .stanza-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }

    .media-frame {
      border: 2px solid var(--accent-gold);
      border-radius: 8px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
    }

    .media-frame img, .media-frame video {
      width: 100%;
      max-height: 430px;
      object-fit: cover;
      display: block;
    }

    .costume-showcase {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .costume-crop-1 {
      height: 200px !important;
      object-fit: cover;
      object-position: center 65%;
    }

    .costume-crop-2 {
      height: 200px !important;
      object-fit: cover;
      object-position: center 55%;
    }

    .caption {
      padding: 0.5rem;
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
      background: rgba(0, 0, 0, 0.65);
      border-top: 1px solid var(--border-subtle);
    }

    .info-card {
      background: rgba(255, 255, 255, 0.03);
      border-left: 4px solid var(--accent-crimson);
      padding: 0.95rem 1.1rem;
      margin-bottom: 0.9rem;
      border-radius: 0 6px 6px 0;
    }

    .stanza-grid .info-card {
      margin-bottom: 0;
    }

    .custom-lyrics-area {
      width: 100%;
      height: 65px;
      background: #120b0b;
      color: var(--text-light);
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      padding: 0.6rem;
      font-family: inherit;
      font-size: 0.9rem;
      margin-top: 0.4rem;
      resize: none;
    }

    .timeline-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.2rem;
      margin-top: 1.2rem;
    }

    .stop-banner {
      margin-top: 1.2rem;
      padding: 1.2rem 1.5rem;
      background: linear-gradient(90deg, rgba(139, 30, 36, 0.35), rgba(201, 166, 107, 0.15));
      border: 2px solid var(--accent-crimson);
      text-align: center;
      border-radius: 8px;
    }

    .stop-banner h3 {
      font-size: 1.5rem;
      color: #ff4d4d;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* Fixed Bottom Scroll Indicator Bar */
    footer {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 0.6rem 2rem;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(15, 10, 10, 0.92);
      backdrop-filter: blur(6px);
      z-index: 100;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .scroll-hint {
      color: var(--accent-gold);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }

    @media (max-width: 950px) {
      .grid-2, .stanza-grid {
        grid-template-columns: 1fr;
      }
      section.slide-page {
        height: auto;
        padding-top: 6.5rem;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">Paris Paloma — "Labour"</div>
    <div class="nav-dots">
      <button class="dot active" onclick="scrollToSlide(0)">1. Artist & Context</button>
      <button class="dot" onclick="scrollToSlide(1)">2. Video & Lyrics</button>
      <button class="dot" onclick="scrollToSlide(2)">3. Traditional Clothing</button>
      <button class="dot" onclick="scrollToSlide(3)">4. Patriarchal Society</button>
      <button class="dot" onclick="scrollToSlide(4)">5. Say STOP Now</button>
    </div>
  </header>

  <main id="scrollContainer">
    <!-- SLIDE 1: PORTRAIT, PERSONAL EXPERIENCE & ROE V. WADE CONTEXT -->
    <section class="slide-page" data-index="0">
      <div class="slide-card">
        <h1>Slide 1: Paris Paloma — An Engaged Artist for Women's Rights</h1>
        <h2>First-Person Testimony, Activism, and the Post-Roe v. Wade Context</h2>
        
        <div class="grid-2">
          <div class="media-frame">
            <img src="8D.png" alt="Portrait of Paris Paloma">
            <div class="caption">Portrait of British singer-songwriter Paris Paloma</div>
          </div>

          <div>
            <div class="info-card">
              <h3>1. Speaking in the First Person ("I") & Personal Experience</h3>
              <p>
                In <em>"Labour"</em>, Paris Paloma writes and sings in the <strong>first person</strong>, drawing directly from lived female experience. By saying "I", she expresses the intimate psychological and physical exhaustion of a woman trapped in an unequal relationship, turning a personal testimony into a universal anthem shared by millions of women worldwide.
              </p>
            </div>

            <div class="info-card">
              <h3>2. An Engaged Singer Fighting for Rights</h3>
              <p>
                Born in Derbyshire, England, and trained in Fine Art History at Goldsmiths, University of London, Paris Paloma uses dark folk and literary mythology as tools of feminist activism. Her music denunciates gender inequality, domestic servitude, and systemic violence against women.
              </p>
            </div>

            <div class="info-card">
              <h3>3. Social Context: The Aftermath of Overturning <em>Roe v. Wade</em></h3>
              <p>
                Released in March 2023 on her debut album <em>Cacophony</em>, the song was written in the direct political shockwave following the June 2022 U.S. Supreme Court decision to overturn <strong>Roe v. Wade</strong>. As women's bodily autonomy and reproductive rights were stripped away, Paloma highlighted how society still seeks to reduce women to unpaid domestic servants and forced child-bearers.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 2: HOSTED VIDEO & THEMATIC LYRIC STUDY -->
    <section class="slide-page" data-index="1">
      <div class="slide-card">
        <h1>Slide 2: Official Music Video & Thematic Study of the Lyrics</h1>
        <h2>Hosted Video & Stanza-by-Stanza Breakdown</h2>

        <div class="grid-2">
          <div>
            <div class="media-frame">
              <video id="localVideo" controls>
                <source src="Paris Paloma - labour [Official Video].mp4" type="video/mp4">
                Your browser does not support the HTML5 video tag.
              </video>
              <div class="caption">Official Video hosted locally: Paris Paloma - labour [Official Video].mp4</div>
            </div>
          </div>

          <div>
            <div class="stanza-grid">
              <div class="info-card">
                <h3>Verse 1: Isolation & Unseen Work</h3>
                <p>
                  The narrator questions why her partner isolates her while she performs endless physical chores alone—tending the orchard, fixing the home, and fetching water—under his emotional mistreatment.
                </p>
              </div>

              <div class="info-card">
                <h3>Chorus: Physical Exhaustion</h3>
                <p>
                  Seeing her burst eye capillaries and cracked hands, she realizes the man she thought was her savior is exploiting her, asking if ending their love could truly be worse than silent servitude.
                </p>
              </div>

              <div class="info-card">
                <h3>Verse 2: Feigned Helplessness</h3>
                <p>
                  She exposes his calculated helplessness as disguised dominance and realizes that if they had a daughter, he would enslave her to the exact same fate—triggering her need to run.
                </p>
              </div>

              <div class="info-card">
                <h3>Bridge: The Imposed Roles</h3>
                <p>
                  She lists the exhausting roles demanded of her 24/7: therapist, mother, maid, object of desire, virgin nurse, servant, and reproductive vessel so he can live out his dreams without lifting a finger.
                </p>
              </div>
            </div>

            <div style="margin-top: 0.75rem;">
              <label for="lyricsNotes" style="color: var(--accent-gold); font-size: 0.85rem;">
                <strong>Personal Presentation Notes / Paste Lyrics Locally Here:</strong>
              </label>
              <textarea id="lyricsNotes" class="custom-lyrics-area" placeholder="Optional: paste your notes or lyrics here..."></textarea>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 3: TRADITIONAL CLOTHING & COSTUME SYMBOLISM -->
    <section class="slide-page" data-index="2">
      <div class="slide-card">
        <h1>Slide 3: Traditional Clothing — Amplifying the Moral & Power of Her Message</h1>
        <h2>How Historical Attire Reinforces the Critique of Domestic Servitude</h2>

        <div class="grid-2">
          <div class="costume-showcase">
            <div class="media-frame">
              <img class="costume-crop-1" src="Paris-Paloma-Labour-music-video-2822365245.jpg" alt="Traditional white linen chemise and red bodice in the Labour video">
              <div class="caption">Period Attire in the Video: White linen chemise, structured red bodice (kirtle), and antique pendant</div>
            </div>

            

          <div>
            <div class="info-card">
              <h3>1. Visualizing the Moral Through Traditional Dress</h3>
              <p>
                In the music video, Paris Paloma wears a <strong>traditional medieval/Renaissance peasant outfit</strong>: a loose white linen chemise with wide sleeves layered under a tight crimson bodice. This costume visually reinforces the moral of her song: even in the modern world, domestic expectations reduce women to the status of historical servants.
              </p>
            </div>

            <div class="info-card">
              <h3>2. Contrasting Period Clothes with Modern Words</h3>
              <p>
                By wearing centuries-old traditional clothing while singing modern expressions (such as <em>"therapist"</em>, <em>"24/7 baby machine"</em>, and <em>"weaponised incompetence"</em>), she creates a striking anachronism. It proves that while fashion and centuries have changed, the patriarchal demand for unpaid female labour remains the same.
              </p>
            </div>

            <div class="info-card">
              <h3>3. Turning a Uniform of Obedience into Power</h3>
              <p>
                Traditionally, the spotless white blouse and laced bodice symbolize female purity, domestic obedience, and social restraint. When she stains this white garment with dark red pomegranate juice at the end of the video, she subverts the costume—transforming a symbol of servitude into an armor of rebellion and self-empowerment.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 4: SOCIAL CONTROL & PATRIARCHAL SOCIETY ACROSS CENTURIES -->
    <section class="slide-page" data-index="3">
      <div class="slide-card">
        <h1>Slide 4: Social Control & Patriarchal Society Across Centuries</h1>
        <h2>How Historical Oppression Persists in Modern Domestic Life</h2>

        <p>
          Both the lyrics and the visual staging of <em>"Labour"</em> demonstrate that the exploitation of women is not an isolated personal issue, but a <strong>systemic mechanism of social control</strong> that has lasted for centuries.
        </p>

        <div class="timeline-cards">
          <div class="info-card">
            <h3>1. Centuries of Historical Servitude</h3>
            <p>
              The music video is deliberately set in a dark, candlelit medieval or Renaissance banquet hall. For centuries, legal, religious, and social systems treated women as the property of their fathers or husbands, confining them to the domestic sphere to serve men's comfort and lineage.
            </p>
          </div>

          <div class="info-card">
            <h3>2. Invisible & Emotional Labour</h3>
            <p>
              Sociologists define <em>emotional and domestic labour</em> as the unpaid, unacknowledged work required to manage a household and regulate a partner's emotions. The song exposes how modern women are still expected to act simultaneously as unpaid therapists, mothers, and maids.
            </p>
          </div>

          <div class="info-card">
            <h3>3. Weaponized Incompetence</h3>
            <p>
              A key mechanism of modern patriarchal control analyzed in the song is <strong>weaponized incompetence</strong>: when a partner pretends not to know how to perform domestic tasks so that the woman is forced to do everything herself, maintaining male privilege under a false disguise.
            </p>
          </div>

          <div class="info-card">
            <h3>4. Breaking Generational Reproduction</h3>
            <p>
              Patriarchal society survives by passing its norms from one generation to the next. In the song, the turning point occurs when the narrator imagines having a daughter and refuses to let another generation of women inherit the same cycle of submission.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 5: END PICTURES - SAYING STOP NOW -->
    <section class="slide-page" data-index="4">
      <div class="slide-card">
        <h1>Slide 5: Visual Climax — Saying "STOP" to Centuries of Control</h1>
        <h2>Reclaiming Power, Subverting Myth, and Leaving the Table</h2>

          <div class="media-frame">
            <img src="Screenshot_2026-10-13_23-05-27.png" alt="Paris Paloma holding the pomegranate">
            <div class="caption">2. The Pomegranate: Reclaiming bodily autonomy and desire</div>
          </div>
        </div>

        <div class="stop-banner">
          <h3>Say STOP Now — Breaking the Chain Forever</h3>
          <p style="margin-top: 0.6rem; margin-bottom: 0;">
            In the final moments of the video, the woman stops serving the feast politely. She seizes the <strong>pomegranate</strong>—a classical symbol of the myth of Persephone trapped in the underworld—and devours it fiercely with her bare hands, rejecting patriarchal manners and reclaiming ownership of her own body. Finally, she walks away and leaves her chair <strong>completely empty</strong>: a powerful call to say <strong>STOP NOW</strong> to centuries of social and patriarchal control.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div id="slideIndicator">Slide 1 of 5</div>
    <div class="scroll-hint">↕ Scroll with Mouse Wheel / Touchpad or Use Up/Down Arrows to Change Slide</div>
  </footer>

  <script>
    const scrollContainer = document.getElementById('scrollContainer');
    const slidePages = document.querySelectorAll('.slide-page');
    const dots = document.querySelectorAll('.dot');
    const indicator = document.getElementById('slideIndicator');
    const video = document.getElementById('localVideo');

    let currentSlide = 0;
    let isWheeling = false;

    // Smoothly scroll to a specific slide index
    function scrollToSlide(index) {
      if (index < 0 || index >= slidePages.length) return;
      slidePages[index].scrollIntoView({ behavior: 'smooth' });
    }

    // Observe which slide is currently visible on screen
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = parseInt(entry.target.getAttribute('data-index'), 10);
          currentSlide = index;

          // Update navigation buttons and bottom indicator
          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === currentSlide);
          });
          indicator.textContent = `Slide ${currentSlide + 1} of ${slidePages.length}`;

          // Automatically pause video if user scrolls away from Slide 2
          if (currentSlide !== 1 && video && !video.paused) {
            video.pause();
          }
        }
      });
    }, {
      root: scrollContainer,
      threshold: 0.55
    });

    slidePages.forEach(slide => observer.observe(slide));

    // Enhance mouse wheel scrolling so one scroll action cleanly steps one slide
    scrollContainer.addEventListener('wheel', (e) => {
      if (document.activeElement.tagName === 'TEXTAREA') return;
      e.preventDefault();

      if (isWheeling) return;
      if (Math.abs(e.deltaY) < 15) return; // Ignore tiny touchpad tremors

      isWheeling = true;
      if (e.deltaY > 0) {
        scrollToSlide(currentSlide + 1);
      } else {
        scrollToSlide(currentSlide - 1);
      }

      setTimeout(() => {
        isWheeling = false;
      }, 650);
    }, { passive: false });

    // Keyboard navigation (Up/Down and Left/Right arrows)
    document.addEventListener('keydown', (e) => {
      if (document.activeElement.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === 'PageDown') {
        e.preventDefault();
        scrollToSlide(currentSlide + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        scrollToSlide(currentSlide - 1);
      }
    });
  </script>
</body>
</html>
